---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="my-8 p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
  <p class="font-semibold text-gray-900 dark:text-gray-100 mb-4">Была ли эта статья полезна?</p>
  <div class="flex gap-3">
    <button
      class="px-4 py-2 rounded-lg bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 hover:bg-green-50 dark:hover:bg-green-900 transition-colors text-sm font-medium text-gray-900 dark:text-gray-100"
      onclick="recordFeedback('{slug}', 'yes')"
    >
      👍 Да, помогла
    </button>
    <button
      class="px-4 py-2 rounded-lg bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 hover:bg-red-50 dark:hover:bg-red-900 transition-colors text-sm font-medium text-gray-900 dark:text-gray-100"
      onclick="recordFeedback('{slug}', 'no')"
    >
      👎 Нет, не помогла
    </button>
  </div>
  <p class="text-xs text-gray-600 dark:text-gray-400 mt-4">
    Ваш отзыв помогает нам улучшать знания. Спасибо!
  </p>
</div>

<script define:vars={{ slug }}>
  function recordFeedback(slug, helpful) {
    // Placeholder для интеграции с аналитикой
    console.log(`Feedback: ${slug} - ${helpful}`);
    // Можно отправить на сервер, когда будет бэкенд
    // fetch('/api/feedback', { method: 'POST', body: JSON.stringify({ slug, helpful }) })
  }
</script>
