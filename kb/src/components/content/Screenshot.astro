---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-6">
  <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
    <img {src} {alt} class="w-full h-auto" loading="lazy" />
  </div>
  {caption && (
    <figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-400 text-center italic">
      {caption}
    </figcaption>
  )}
</figure>
