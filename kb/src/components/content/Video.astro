---
interface Props {
  src: string;
  caption?: string;
}

const { src, caption } = Astro.props;

const isGif = src.endsWith('.gif');
---

<figure class="my-6">
  <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow bg-black">
    {isGif ? (
      <img {src} alt="Animation" class="w-full h-auto" loading="lazy" />
    ) : (
      <video
        class="w-full h-auto"
        controls
        autoplay
        loop
        muted
        playsinline
      >
        <source {src} type="video/mp4" />
        Ваш браузер не поддерживает видео.
      </video>
    )}
  </div>
  {caption && (
    <figcaption class="mt-3 text-sm text-gray-600 dark:text-gray-400 text-center italic">
      {caption}
    </figcaption>
  )}
</figure>
