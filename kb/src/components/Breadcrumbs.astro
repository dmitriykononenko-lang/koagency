---
interface Props {
  section: string;
  subsection: string;
}

const { section, subsection } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
    <li>
      <a href="/" class="hover:text-accent transition-colors">Главная</a>
    </li>
    <li>/</li>
    <li>
      <a href={`/#${section.toLowerCase()}`} class="hover:text-accent transition-colors">
        {section}
      </a>
    </li>
    <li>/</li>
    <li class="text-gray-900 dark:text-gray-100 font-medium">
      {subsection}
    </li>
  </ol>
</nav>
