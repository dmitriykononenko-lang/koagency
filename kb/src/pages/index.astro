---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const docs = await getCollection('docs');

interface Section {
  title: string;
  id: string;
  subsections: Array<{
    title: string;
    id: string;
    articles: Array<{ slug: string; title: string }>;
  }>;
}

const navSections: Section[] = [
  {
    title: 'Начало работы',
    id: 'getting-started',
    subsections: [
      {
        title: 'Старт',
        id: 'start',
        articles: [{ slug: 'login-kommo', title: 'Вход в аккаунт' }],
      },
      {
        title: 'Основные операции',
        id: 'operations',
        articles: [{ slug: 'deal-fields-setup', title: 'Настройка полей сделки' }],
      },
    ],
  },
  {
    title: 'Воронка продаж',
    id: 'funnel',
    subsections: [
      {
        title: 'Работа с воронкой',
        id: 'funnel-work',
        articles: [{ slug: 'funnel-work', title: 'Работа с воронкой продаж' }],
      },
    ],
  },
];
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kommo Support — База знаний</title>
    <meta name="description" content="Полная база знаний для Kommo/amoCRM. Руководства, статьи и лучшие практики." />
    <meta property="og:title" content="Kommo Support — База знаний" />
    <meta property="og:description" content="Полная база знаний для Kommo/amoCRM. Руководства, статьи и лучшие практики." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kb.kommo.example.com/" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="bg-white dark:bg-brand-dark text-gray-900 dark:text-gray-100">
    <!-- Header -->
    <header class="border-b border-gray-200 dark:border-gray-700 sticky top-0 bg-white dark:bg-brand-dark z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-accent">Kommo Support</a>
        <button
          id="theme-toggle"
          class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
          <svg class="w-5 h-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l-2.83-2.83a1 1 0 00-1.414 1.414l2.83 2.83a1 1 0 001.414-1.414zM2.05 6.464l2.83 2.83a1 1 0 01-1.414 1.414L.636 7.878a1 1 0 011.414-1.414zM5.464 5.464a1 1 0 00-1.414-1.414L1.172 6.586a1 1 0 001.414 1.414l2.878-2.878z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Hero Section -->
      <section class="mb-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Kommo Support</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
          Полная база знаний для работы с Kommo. Руководства, лучшие практики и ответы на частые вопросы.
        </p>

        <!-- Search Placeholder -->
        <div class="mb-12">
          <div class="relative">
            <input
              type="text"
              placeholder="Найти статью..."
              class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:border-accent"
            />
            <svg class="absolute right-3 top-3.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </section>

      <!-- Sections Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {
          docs.slice(0, 6).map((doc) => (
            <a
              href={`/docs/${doc.data.slug}`}
              class="p-6 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-accent hover:shadow-md transition-all group"
            >
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                {doc.data.section}
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-accent transition-colors mb-2">
                {doc.data.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                {doc.data.description}
              </p>
            </a>
          ))
        }
      </section>

      <!-- Table of Contents -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8">Все разделы</h2>
        <div class="space-y-8">
          {
            navSections.map((section) => (
              <div>
                <h3 class="text-xl font-bold text-accent mb-4">{section.title}</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {section.subsections.map((subsection) => (
                    <div class="p-4 rounded-lg bg-gray-50 dark:bg-gray-800">
                      <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-3">{subsection.title}</h4>
                      <ul class="space-y-2">
                        {subsection.articles.map((article) => (
                          <li>
                            <a href={`/docs/${article.slug}`} class="text-accent hover:underline transition-colors">
                              → {article.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Stats -->
      <section class="bg-gray-50 dark:bg-gray-800 rounded-lg p-8 mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="text-4xl font-bold text-accent">{docs.length}</div>
            <div class="text-gray-600 dark:text-gray-400 mt-2">Статей в базе</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-accent">{navSections.length}</div>
            <div class="text-gray-600 dark:text-gray-400 mt-2">Основных разделов</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-accent">100%</div>
            <div class="text-gray-600 dark:text-gray-400 mt-2">Контента на русском</div>
          </div>
        </div>
      </section>

      <!-- Footer CTA -->
      <section class="text-center py-12 border-t border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-bold mb-4">Остались вопросы?</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-lg mx-auto">
          Свяжитесь с командой ko:agency для получения помощи с интеграцией, настройкой и обучением.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:support@koagency.com"
            class="px-6 py-3 bg-accent text-white rounded-lg hover:opacity-90 transition-opacity font-semibold"
          >
            Написать в поддержку
          </a>
          <a
            href="https://koagency.me"
            target="_blank"
            class="px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg hover:border-accent transition-colors font-semibold"
          >
            Посетить сайт ko:agency
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-gray-700 mt-12 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-sm text-gray-600 dark:text-gray-400">
        © 2026 ko:agency. Комплексная интеграция amoCRM/Kommo.
      </div>
    </footer>

    <script>
      // Dark mode toggle
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      const savedTheme = localStorage.getItem('theme') || 'light';
      if (savedTheme === 'dark') {
        html.classList.add('dark');
      }

      themeToggle?.addEventListener('click', () => {
        html.classList.toggle('dark');
        const theme = html.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', theme);
      });
    </script>
  </body>
</html>
