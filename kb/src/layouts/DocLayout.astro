---
import { formatDate, calculateReadingTime } from '../utils/helpers';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';
import Related from '../components/Related.astro';
import Feedback from '../components/Feedback.astro';
import Toc from '../components/Toc.astro';
import '../styles/global.css';

interface Props {
  title: string;
  slug: string;
  description: string;
  section: string;
  subsection: string;
  updated?: string;
  readingTime?: string;
  related?: string[];
  prev?: string;
  next?: string;
}

const { title, slug, description, section, subsection, updated, readingTime, related = [], prev, next } = Astro.props;

const finalReadingTime = readingTime || calculateReadingTime(Astro.slots.render('default'));
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Kommo Support</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Kommo Support`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://kb.kommo.example.com/docs/${slug}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Kommo Support`} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="bg-white dark:bg-brand-dark text-gray-900 dark:text-gray-100">
    <div class="min-h-screen flex flex-col">
      <!-- Header -->
      <header class="border-b border-gray-200 dark:border-gray-700 sticky top-0 bg-white dark:bg-brand-dark z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
          <a href="/" class="text-2xl font-bold text-accent">Kommo Support</a>
          <button
            id="theme-toggle"
            class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            aria-label="Toggle theme"
          >
            <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
            </svg>
            <svg class="w-5 h-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l-2.83-2.83a1 1 0 00-1.414 1.414l2.83 2.83a1 1 0 001.414-1.414zM2.05 6.464l2.83 2.83a1 1 0 01-1.414 1.414L.636 7.878a1 1 0 011.414-1.414zM5.464 5.464a1 1 0 00-1.414-1.414L1.172 6.586a1 1 0 001.414 1.414l2.878-2.878z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </header>

      <div class="flex flex-1">
        <!-- Main Content -->
        <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
          <Breadcrumbs section={section} subsection={subsection} />

          <article>
            <header class="mb-8">
              <h1 class="text-4xl font-bold mb-4">{title}</h1>
              <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
                {updated && <span>Обновлено {formatDate(updated)}</span>}
                {finalReadingTime && <span>Время чтения: {finalReadingTime}</span>}
              </div>
            </header>

            <!-- Action Buttons -->
            <div class="flex gap-3 mb-8 border-b border-gray-200 dark:border-gray-700 pb-8">
              <button
                class="px-3 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-sm flex items-center gap-2"
                onclick="window.print()"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4H9a2 2 0 00-2 2v2a2 2 0 002 2h12a2 2 0 002-2v-2a2 2 0 00-2-2h-2m-4-4V9m0 4v6m0 0v2m0-2v-2"
                  />
                </svg>
                Печать
              </button>

              <button
                class="px-3 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-sm flex items-center gap-2"
                id="copy-markdown-btn"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                  />
                </svg>
                Копировать как Markdown
              </button>

              <button
                class="px-3 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-sm flex items-center gap-2"
                id="open-claude-btn"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                Открыть в Claude
              </button>
            </div>

            <!-- Article Content -->
            <div class="prose dark:prose-invert max-w-none mb-12">
              <slot />
            </div>

            <!-- Helpful? -->
            <Feedback slug={slug} />
          </article>

          <!-- Related Articles -->
          {related.length > 0 && <Related slugs={related} />}

          <!-- Prev/Next Navigation -->
          <PrevNext prev={prev} next={next} />
        </main>
      </div>

      <!-- Footer -->
      <footer class="border-t border-gray-200 dark:border-gray-700 mt-12 bg-gray-50 dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <h3 class="text-lg font-bold mb-4">Остались вопросы?</h3>
              <p class="text-gray-600 dark:text-gray-400">
                Свяжитесь с командой ko:agency для получения помощи с интеграцией и настройкой.
              </p>
            </div>
            <div>
              <h4 class="font-semibold mb-3">Контакты</h4>
              <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                <li><a href="mailto:support@koagency.com" class="hover:text-accent transition-colors">support@koagency.com</a></li>
                <li><a href="https://koagency.me" class="hover:text-accent transition-colors">koagency.me</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold mb-3">Лучшие практики</h4>
              <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                <li><a href="/docs/login-kommo" class="hover:text-accent transition-colors">Вход в аккаунт</a></li>
                <li><a href="/docs/funnel-work" class="hover:text-accent transition-colors">Работа с воронкой</a></li>
              </ul>
            </div>
          </div>
          <div class="border-t border-gray-200 dark:border-gray-700 mt-8 pt-8 text-center text-sm text-gray-600 dark:text-gray-400">
            © 2026 ko:agency. Комплексная интеграция amoCRM/Kommo.
          </div>
        </div>
      </footer>
    </div>

    <style>
      :root {
        --text-primary: rgb(17, 24, 39);
        --text-secondary: rgb(107, 114, 128);
        --bg-code: rgb(243, 244, 246);
        --text-code: rgb(31, 41, 55);
      }

      :root.dark {
        --text-primary: rgb(243, 244, 246);
        --text-secondary: rgb(156, 163, 175);
        --bg-code: rgb(31, 41, 55);
        --text-code: rgb(209, 213, 219);
      }
    </style>

    <script>
      // Dark mode toggle
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      // Check for saved theme preference or default to 'light'
      const savedTheme = localStorage.getItem('theme') || 'light';
      if (savedTheme === 'dark') {
        html.classList.add('dark');
      }

      themeToggle?.addEventListener('click', () => {
        html.classList.toggle('dark');
        const theme = html.classList.contains('dark') ? 'dark' : 'light';
        localStorage.setItem('theme', theme);
      });

      // Copy as Markdown
      const copyMarkdownBtn = document.getElementById('copy-markdown-btn');
      copyMarkdownBtn?.addEventListener('click', async () => {
        try {
          const url = `${window.location.pathname}.md`;
          const response = await fetch(url);
          const markdown = await response.text();
          await navigator.clipboard.writeText(markdown);
          const originalText = copyMarkdownBtn.textContent;
          copyMarkdownBtn.textContent = '✓ Скопировано!';
          setTimeout(() => {
            copyMarkdownBtn.textContent = originalText;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy markdown:', err);
        }
      });

      // Open in Claude
      const openClaudeBtn = document.getElementById('open-claude-btn');
      openClaudeBtn?.addEventListener('click', () => {
        const mdUrl = `${window.location.pathname}.md`;
        window.open(`https://claude.ai?tab=docs&url=${encodeURIComponent(mdUrl)}`, '_blank');
      });
    </script>
  </body>
</html>
